rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    match /quotes/{quoteId} {
      allow create: if isValidId(quoteId) 
                    && incoming().keys().hasOnly(['name', 'phone', 'email', 'projectType', 'message', 'createdAt'])
                    && incoming().name is string && incoming().name.size() <= 100 && incoming().name.size() > 0
                    && incoming().phone is string && incoming().phone.size() <= 20 && incoming().phone.size() > 0
                    && incoming().projectType is string && incoming().projectType.size() <= 50
                    && incoming().email is string && incoming().email.size() <= 100
                    && incoming().message is string && incoming().message.size() <= 2000
                    && incoming().createdAt == request.time;
      allow read, delete: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId)
                    && incoming().author is string && incoming().author.size() <= 100
                    && incoming().comment is string && incoming().comment.size() <= 2000;
      allow update, delete: if true;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /caddie_scans/{scanId} {
      allow read: if true;
      allow create: if isValidId(scanId)
                    && incoming().source is string && incoming().source.size() <= 100
                    && incoming().rawUrl is string && incoming().rawUrl.size() <= 500;
      allow update, delete: if true;
    }

    match /site_visits/{visitId} {
      allow read: if true;
      allow create: if isValidId(visitId)
                    && incoming().page is string && incoming().page.size() <= 200;
      allow update, delete: if true;
    }

    match /mail_classifications/{classificationId} {
      allow read, write: if true;
    }
    
    match /content/{docId} {
      allow read: if true;
      allow update: if isValidId(docId) 
                    && incoming().adminCode == '0107'
                    && incoming().diff(existing()).affectedKeys().hasOnly(['heroTitle', 'heroSubtitle', 'aboutText1', 'aboutText2', 'updatedAt', 'adminCode'])
                    && (incoming().heroTitle == null || (incoming().heroTitle is string && incoming().heroTitle.size() <= 200))
                    && (incoming().heroSubtitle == null || (incoming().heroSubtitle is string && incoming().heroSubtitle.size() <= 500))
                    && (incoming().aboutText1 == null || (incoming().aboutText1 is string && incoming().aboutText1.size() <= 2000))
                    && (incoming().aboutText2 == null || (incoming().aboutText2 is string && incoming().aboutText2.size() <= 2000))
                    && incoming().updatedAt == request.time;
      allow create: if isValidId(docId) 
                    && incoming().adminCode == '0107'
                    && incoming().keys().hasOnly(['heroTitle', 'heroSubtitle', 'aboutText1', 'aboutText2', 'updatedAt', 'adminCode'])
                    && incoming().heroTitle is string && incoming().heroTitle.size() <= 200
                    && incoming().heroSubtitle is string && incoming().heroSubtitle.size() <= 500
                    && incoming().aboutText1 is string && incoming().aboutText1.size() <= 2000
                    && incoming().aboutText2 is string && incoming().aboutText2.size() <= 2000
                    && incoming().updatedAt == request.time;
    }
    
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if incoming().adminCode == '0107';
      allow delete: if incoming().adminCode == '0107';
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update: if incoming().adminCode == '0107';
      allow delete: if true; 
    }

    match /beforeAfter/{docId} {
      allow read: if true;
      allow create, update: if incoming().adminCode == '0107';
      allow delete: if true; 
    }

    match /mileage_trips/{tripId} {
      allow read, write: if true;
    }

    match /mileage_vehicles/{vehicleId} {
      allow read, write: if true;
    }

    function isValidFeedPost(data) {
      return data.keys().hasAll(['content', 'category', 'mediaType', 'dateLabel', 'publishedAt', 'ctaType', 'adminCode'])
             && data.keys().hasOnly(['content', 'category', 'location', 'mediaType', 'mediaUrl', 'videoPosterUrl', 'dateLabel', 'publishedAt', 'ctaType', 'ctaUrl', 'sourceTag', 'adminCode'])
             && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
             && data.category is string && data.category.size() <= 80
             && data.mediaType in ['image', 'video', 'none']
             && data.ctaType in ['learn_more', 'call', 'quote', 'none']
             && data.dateLabel is string && data.dateLabel.size() <= 40
             && data.publishedAt is string && data.publishedAt.size() <= 40
             && (!('location' in data) || (data.location is string && data.location.size() <= 100))
             && (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 900000))
             && (!('videoPosterUrl' in data) || (data.videoPosterUrl is string && data.videoPosterUrl.size() <= 500))
             && (!('ctaUrl' in data) || (data.ctaUrl is string && data.ctaUrl.size() <= 300))
             && (!('sourceTag' in data) || (data.sourceTag is string && data.sourceTag.size() <= 60))
             && data.adminCode == '0107';
    }

    match /feed_posts/{postId} {
      allow read: if true;
      allow create, update: if isValidId(postId) && isValidFeedPost(incoming());
      allow delete: if isValidId(postId);
    }

    match /appointments/{appId} {
      allow read: if true;
      allow create, update: if incoming().adminCode == '0107';
      allow delete: if true;
    }
  }
}
