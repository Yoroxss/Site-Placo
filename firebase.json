{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/zones-intervention-renovation-bassin-arcachon{,/**}",
        "destination": "/#zone-intervention",
        "type": 301
      },
      {
        "source": "/plaquiste-platrier-bassin-arcachon/mentions-legales{,/**}",
        "destination": "/mentions-legales",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
